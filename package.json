{
  "name": "digitalanalogue9.github.io",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "clean": "rimraf dist && rimraf node_modules",
    "generate-meta": "node scripts/generate-meta-files.js",
    "dev": "vite",
    "build": "vite build && node scripts/create-pages-routes.js && node scripts/generate-personal-route-metadata.js",
    "start": "vite preview",
    "preview": "vite preview",
    "kill-ports": "node scripts/kill-ports.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "check:ci": "node scripts/check-ci.js",
    "ts-prune": "ts-prune --project tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:routing": "playwright test tests/e2e/app-routing.spec.ts",
    "test:e2e:smoke": "playwright test tests/e2e/first-run.spec.ts",
    "test:e2e:reflection:both": "node scripts/test-reflection-e2e-both.js",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "reorganise": "node scripts/reorganise-features.js",
    "format": "prettier --write .",
    "format:check": "node scripts/check-formatting.js",
    "validate:pages-artifact": "node scripts/pages-artifact-validator.js",
    "codex:init-watch": "codex-mem codex init && codex-mem codex watch"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@heroicons/react": "^2.2.0",
    "@microsoft/applicationinsights-web": "^3.4.5",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "file-saver-es": "^2.0.5",
    "framer-motion": "^14.9.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "use-sync-external-store": "^1.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/generator": "^8.1.0",
    "@babel/parser": "^8.1.0",
    "@babel/traverse": "^8.1.0",
    "@babel/types": "^8.1.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/file-saver-es": "^2.0.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-anti-slop": "^0.5.0",
    "eslint-plugin-react": "^7.37.5",
    "fake-indexeddb": "^6.2.7",
    "fs-extra": "^11.4.1",
    "glob": "^14.0.3",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "ts-prune": "^0.10.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
